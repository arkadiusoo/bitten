FROM python:3.13-slim

WORKDIR /app

COPY requirements.txt .

RUN pip install --no-cache-dir -r requirements.txt

RUN useradd --uid 6767 --create-home --shell /usr/sbin/nologin appuser

COPY app/ ./app/

RUN chmod 644 /app/app/main.py

USER appuser

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]