# Normalize text files
* text=auto

# Use Unix line endings for application and infrastructure files
*.py text eol=lf
*.sh text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.tf text eol=lf
Dockerfile text eol=lf
Containerfile text eol=lf

# Use Windows line endings for Windows scripts
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf